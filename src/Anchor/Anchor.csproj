<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>anchor</AssemblyName>
    <RootNamespace>Anchor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anchor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.1.0" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
